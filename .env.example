# Web
WEB_PORT=8787
SESSION_DAYS=30
ALLOW_REGISTRATION=false

# Legacy/default SHOUTcast profile.
# On the first v2 login/setup these values become the first account's stream profile.
# Afterwards each user edits their own profile in Settings.
SHOUTCAST_HOST=stream.example.com
SHOUTCAST_PORT=8000
SHOUTCAST_PASSWORD=change-me
SHOUTCAST_SID=1
STREAM_NAME=Tasia Radio
STREAM_GENRE=AI Music
STREAM_URL=https://example.com
STREAM_PUBLIC=false
BITRATE_KBPS=192
SAMPLE_RATE=44100
AUTOPLAY_LIBRARY=true

# Remote downloads
MAX_REMOTE_MB=250
ALLOW_PRIVATE_URLS=false

# Container paths - normally leave these alone
DB_PATH=/data/tasia.db
MUSIC_DIR=/music
USER_DATA_DIR=/data/users
