{
  "manifest_version": 3,
  "name": "Tasia Spotify Connector",
  "version": "1.0.0",
  "description": "Keeps Spotify text search available in your own Tasia Streamer without a Spotify developer app.",
  "permissions": ["storage", "webRequest", "alarms", "tabs"],
  "host_permissions": [
    "https://api.spotify.com/*",
    "https://api-partner.spotify.com/*",
    "https://spclient.wg.spotify.com/*",
    "https://open.spotify.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Tasia Spotify Connector"}
}
