settings.log.stdout := true
settings.log.level := 3
settings.server.telnet := true
settings.server.telnet.bind_addr := "127.0.0.1"
settings.server.telnet.port := __CONTROL_PORT__

# Python owns this user's persistent queue and resolves local/cached/provider audio URIs.
# Tasia Talk may need a little longer than a normal local-track lookup because its
# next item can be an AI + Edge-TTS interstitial prepared while the current song plays.
def next_request() =
  result = list.hd(
    default="",
    process.read.lines("curl -fsS --max-time 55 'http://127.0.0.1:8080/internal/next/__USER_ID__?key=__INTERNAL_KEY__'")
  )
  if result == "" then [] else [request.create(result)] end
end

scheduler = request.dynamic.list(
  id="scheduler",
  prefetch=1,
  retry_delay=2.,
  timeout=60.,
  next_request
)
add_skip_command(scheduler)

# DJ play/pause. Pause keeps SHOUTcast connected and feeds silence.
tasia_playout = interactive.bool("tasia_playout", true)
music = switch(track_sensitive=false, [
  ({tasia_playout()}, scheduler),
  ({true}, blank())
])

# Live LSL/OpenSim speech behaves like a DJ microphone rather than a scheduled
# track. Python pushes the finished Edge-TTS file with:
#   tasia_live.push file:///data/users/.../tts/tasia-....mp3
#
# While a voice request is ready/playing, music is ducked to 30% and Tasia is
# mixed at full level. As soon as the voice queue becomes empty, music returns
# to normal automatically. clip() protects the final mix from rare summed peaks.
tasia_live = request.queue(
  id="tasia_live",
  interactive=true,
  prefetch=1,
  timeout=30.
)
ducked_music = amplify(
  override=null,
  {if tasia_live.is_ready() then 0.30 else 1.0 end},
  music
)
# Track metadata on the music leg before add(): Liquidsoap's mixer drops
# track marks. The music source is still pulled by the final output continuously,
# so this stays tied to real playout while live Tasia speech overlays it.
current_meta = ref([])
ducked_music.on_track(
  synchronous=true,
  fun (m) -> current_meta := m
)

radio = add(normalize=false, [ducked_music, tasia_live])
radio = clip(radio)

def get_internal_meta(_, response) =
  response.json(current_meta())
end
harbor.http.register(port=__META_PORT__, method="GET", "/internal-meta", get_internal_meta)

# Do not connect until the web UI presses Connect.
output.shoutcast(
  %mp3(bitrate=__BITRATE__, samplerate=__SAMPLE_RATE__, stereo=true),
  id="shoutcast",
  start=false,
  host="__HOST__",
  port=__PORT__,
  password="__PASSWORD__",
  icy_id=__SID__,
  name="__NAME__",
  genre="__GENRE__",
  url="__URL__",
  public=__PUBLIC__,
  send_icy_metadata=true,
  radio
)
